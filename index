      <h3 data-template-id="q5-title" class="canva-text font-bold mb-4" style="font-weight: 700; font-style: normal; font-size: 19px;">5. Apa peran sumsum tulang belakang saat tangan menyentuh benda panas?</h3>
      <div class="grid gap-2">
       <button data-template-id="q5-a" type="button" class="canva-button quiz-option" data-option="0" style="font-weight: 400; font-style: normal; font-size: 16px;">Memproses impuls pada jalur refleks dan meneruskan perintah respons</button><button data-template-id="q5-b" type="button" class="canva-button quiz-option" data-option="1" style="font-weight: 400; font-style: normal; font-size: 16px;">Menghasilkan panas pada kulit</button><button data-template-id="q5-c" type="button" class="canva-button quiz-option" data-option="2" style="font-weight: 400; font-style: normal; font-size: 16px;">Menggantikan fungsi otot tangan</button>
      </div>
      <p data-template-id="q5-explanation" class="canva-text hidden mt-4" style="font-weight: 400; font-style: normal; font-size: 16px;">Dalam gerak refleks ini, sumsum tulang belakang berperan sebagai pusat pemrosesan respons cepat.</p>
     </div>
     <p id="quiz-feedback" class="mt-4 font-bold" role="status" aria-live="polite"></p><button id="next-button" data-template-id="next-button" type="button" class="canva-button hidden mt-4 rounded-xl px-5 py-3 font-bold" style="background: rgb(23, 122, 99); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 16px;">Soal berikutnya →</button>
     <div id="quiz-result" class="hidden mt-5">
      <p id="score-text" class="font-bold text-[#173c65]" role="status"></p><button id="restart-button" data-template-id="restart-button" type="button" class="canva-button mt-4 rounded-xl px-5 py-3 font-bold" style="background: rgb(23, 60, 101); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 16px;">Coba lagi</button>
     </div>
    </section>
    <section id="refleksi" class="route-section surface rounded-[28px] p-6 md:p-9" aria-labelledby="reflection-title" hidden="">
     <p data-template-id="reflection-kicker" class="canva-text eyebrow" style="color: rgb(23, 122, 99); font-weight: 400; font-style: normal; font-size: 12px;">04 / RENUNGKAN</p>
     <h2 id="reflection-title" data-template-id="reflection-title" class="canva-text section-title mt-1 mb-2" style="color: rgb(23, 60, 101); font-weight: 800; font-style: normal; font-size: 24px;">Refleksi belajarku</h2>
     <p data-template-id="reflection-intro" class="canva-text mb-5" style="font-weight: 400; font-style: normal; font-size: 16px;">Tuliskan pemahamanmu dengan kata-katamu sendiri. Jawaban tetap terlihat selama halaman ini terbuka.</p>
     <form id="reflection-form" class="space-y-5">
      <div>
       <label data-template-id="reflection-label-1" for="reflection-1" class="canva-text block font-bold mb-2" style="font-weight: 700; font-style: normal; font-size: 16px;">Hal baru apa yang saya pahami?</label><textarea id="reflection-1" rows="3" class="w-full rounded-xl border border-slate-300 p-3 bg-white" placeholder="Tuliskan hal baru yang kamu pelajari..."></textarea>
      </div>
      <div>
       <label data-template-id="reflection-label-2" for="reflection-2" class="canva-text block font-bold mb-2" style="font-weight: 700; font-style: normal; font-size: 16px;">Bagian mana yang masih membingungkan?</label><textarea id="reflection-2" rows="3" class="w-full rounded-xl border border-slate-300 p-3 bg-white" placeholder="Tuliskan pertanyaanmu..."></textarea>
      </div>
      <div>
       <label data-template-id="reflection-label-3" for="reflection-3" class="canva-text block font-bold mb-2" style="font-weight: 700; font-style: normal; font-size: 16px;">Contoh respons tubuh yang saya temui hari ini?</label><textarea id="reflection-3" rows="3" class="w-full rounded-xl border border-slate-300 p-3 bg-white" placeholder="Ceritakan contoh sehari-hari..."></textarea>
      </div><button data-template-id="reflection-button" type="submit" class="canva-button rounded-xl px-5 py-3 font-bold" style="background: rgb(23, 122, 99); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 16px;">Tandai selesai</button>
      <p id="reflection-status" role="status" aria-live="polite" class="font-semibold text-[#177a63]"></p>
     </form>
    </section>
    <footer class="pt-9">
     <p data-template-id="footer-text" class="canva-text text-center" style="color: rgb(82, 107, 123); font-weight: 400; font-style: normal; font-size: 16px;">Sistem Saraf Manusia · Mata Pelajaran IPA Kelas IX</p>
    </footer>
   </div>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons();

      const mainContent = document.getElementById('mainContent');
      const navLinks = [...document.querySelectorAll('.sidebar-nav a')];
      const routes = [...document.querySelectorAll('.route-section')];
      function showRoute(id) {
        if (!routes.some(route => route.id === id)) return;
        routes.forEach(route => { route.hidden = route.id !== id; });
        navLinks.forEach(link => {
          if (link.getAttribute('href') === '#' + id) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
        mainContent.scrollTop = 0;
      }
      navLinks.forEach(link => link.addEventListener('click', event => {
        event.preventDefault();
        showRoute(link.getAttribute('href').slice(1));
      }));
      const initialRoute = location.hash.slice(1);
      if (initialRoute && routes.some(route => route.id === initialRoute)) showRoute(initialRoute);

      const neuronCard = document.getElementById('neuron-detail-card');
      const neuronInfo = document.getElementById('neuron-info');
      const neuronButtons = [...neuronCard.querySelectorAll('[data-neuron-part]')];
      const neuronPanels = [...neuronCard.querySelectorAll('[data-info]')];
      function clearNeuronSelection(restoreFocus) {
        neuronCard.removeAttribute('data-active');
        neuronButtons.forEach(button => button.setAttribute('aria-pressed', 'false'));
        neuronPanels.forEach(panel => { panel.hidden = true; });
        neuronInfo.hidden = true;
        if (restoreFocus) document.getElementById('neuron-instruction').focus();
      }
      neuronButtons.forEach(button => button.addEventListener('click', () => {
        neuronCard.dataset.active = button.dataset.neuronPart;
        neuronButtons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        neuronPanels.forEach(panel => { panel.hidden = panel.dataset.info !== button.dataset.neuronPart; });
        neuronInfo.hidden = false;
      }));
      document.getElementById('neuron-reset').addEventListener('click', () => clearNeuronSelection(true));
      document.getElementById('neuron-close').addEventListener('click', () => clearNeuronSelection(true));

      const steps = [...document.querySelectorAll('.sim-step')];
      const simStatus = document.getElementById('sim-status');
      let simTimer = null, simIndex = -1;
      function renderSimulation() {
        steps.forEach((step,index) => {
          step.classList.toggle('is-active',index === simIndex);
          step.classList.toggle('is-done',index < simIndex);
        });
        simStatus.textContent = simIndex < 0 ? 'Siap dimulai · 0 dari 5 tahap' : simIndex >= steps.length ? 'Selesai · 5 dari 5 tahap. Tangan menjauh dari panas.' : `Tahap aktif ${simIndex + 1} dari ${steps.length}`;
      }
      function stopSimulation() { if (simTimer !== null) clearTimeout(simTimer); simTimer = null; }
      function advanceSimulation() {
        simIndex++;
        renderSimulation();
        if (simIndex < steps.length) simTimer = setTimeout(advanceSimulation, matchMedia('(prefers-reduced-motion: reduce)').matches ? 650 : 1450);
        else simTimer = null;
      }
      document.getElementById('sim-start').addEventListener('click', () => { stopSimulation(); simIndex = -1; advanceSimulation(); });
      document.getElementById('sim-reset').addEventListener('click', () => { stopSimulation(); simIndex = -1; renderSimulation(); });

      const questions = [...document.querySelectorAll('.quiz-question')];
      const feedback = document.getElementById('quiz-feedback');
      const progress = document.getElementById('quiz-progress');
      const next = document.getElementById('next-button');
      const result = document.getElementById('quiz-result');
      let current = 0, score = 0, answered = false;
      function showQuestion() {
        questions.forEach((question,index) => question.classList.toggle('hidden',index !== current));
        progress.textContent = `Pertanyaan ${current + 1} dari ${questions.length}`;
        feedback.textContent = '';
        next.classList.add('hidden');
        answered = false;
      }
      questions.forEach(question => question.querySelectorAll('[data-option]').forEach(button => button.addEventListener('click', () => {
        if (answered) return;
        answered = true;
        const correct = Number(question.dataset.correct);
        const chosen = Number(button.dataset.option);
        if (chosen === correct) score++;
        question.querySelectorAll('[data-option]').forEach(option => {
          option.disabled = true;
          if (Number(option.dataset.option) === correct) option.classList.add('is-correct');
          else if (option === button) option.classList.add('is-incorrect');
        });
        feedback.textContent = chosen === correct ? 'Benar! Hebat.' : 'Perlu belajar lagi. Jawaban yang tepat ditandai hijau.';
        feedback.style.color = chosen === correct ? '#177a63' : '#a64b12';
        question.querySelector('[data-template-id$="-explanation"]').classList.remove('hidden');
        if (current < questions.length - 1) next.classList.remove('hidden');
        else {
          progress.textContent = 'Kuis selesai';
          document.getElementById('score-text').textContent = `Skor kamu: ${score} dari ${questions.length}.`;
          result.classList.remove('hidden');
        }
      })));
      next.addEventListener('click', () => {
        if (!answered || current >= questions.length - 1) return;
        current++;
        showQuestion();
        questions[current].querySelector('[data-option]').focus();
      });
      document.getElementById('restart-button').addEventListener('click', () => {
        current = 0; score = 0;
        questions.forEach(question => {
          question.querySelectorAll('[data-option]').forEach(option => {
            option.disabled = false;
            option.classList.remove('is-correct','is-incorrect');
          });
          question.querySelector('[data-template-id$="-explanation"]').classList.add('hidden');
        });
        result.classList.add('hidden');
        showQuestion();
        questions[0].querySelector('[data-option]').focus();
      });
      showQuestion();

      document.getElementById('reflection-form').addEventListener('submit', event => {
        event.preventDefault();
        const fields = ['reflection-1','reflection-2','reflection-3'].map(id => document.getElementById(id));
        const blank = fields.find(field => !field.value.trim());
        const status = document.getElementById('reflection-status');
        if (blank) {
          status.textContent = 'Isi ketiga jawaban sebelum menandai selesai.';
          status.style.color = '#a64b12';
          blank.focus();
          return;
        }
        status.textContent = 'Refleksi ditandai selesai selama halaman ini terbuka.';
        status.style.color = '#177a63';
      });
    });
  </script>
 
</body></html>
